[package]
name = "split-decls-rs"
version = "0.1.0"
edition = "2024"

[lib]
path = "src/lib.rs"

[dependencies]
introspector_decl_core = { workspace=true }

syn = { version = "2.0", features = ["full", "extra-traits", "visit"] }
quote = "1.0"
proc-macro2 = "1.0"
walkdir = "2.5"
anyhow = "1.0"
toml = "0.8"
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
once_cell = "1.19"
url = "2.0" # Added for git_manager
introspector_decl2_macros = { path = "../patch-build-rs/introspector_decl2_macros" }

introspector_macro_helpers = { path = "../patch-build-rs/introspector_macro_helpers" }
introspector_decl_common = { path = "../patch-build-rs/introspector_decl_common" }
unimacro_derive = { path = "../../unimacro_derive", optional = true }


[features]
enable_unimacro_derive = ["unimacro_derive"]


[dev-dependencies]
tempfile = "3.8"
assert_cmd = "2.0"
predicates = "2.0"


#[workspace]
#members = ["."]

